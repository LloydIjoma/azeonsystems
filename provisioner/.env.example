# Copy to .env (same directory) and fill in real values.
# Loaded by systemd via EnvironmentFile=, or by python-dotenv in dev.

# Shared secret used to verify the X-Azeon-Signature HMAC header on
# incoming provisioning webhooks. Generate with: openssl rand -hex 32
PROVISIONER_WEBHOOK_SECRET=

# Absolute path to the Frappe bench created by scripts/vps_setup.sh
BENCH_DIR=/home/frappe/frappe-bench

# Linux user that owns the bench (must match vps_setup.sh's FRAPPE_USER)
FRAPPE_USER=frappe

# Tenant sites are created as <slug>.<DOMAIN_SUFFIX>
DOMAIN_SUFFIX=azeonsystems.com.ng

# MariaDB root password, if one was set during MariaDB install.
# Leave blank ONLY if root auth is otherwise handled (e.g. unix_socket
# for the OS root user) — see provisioner/README.md caveat.
MARIADB_ROOT_PASSWORD=

# Absolute path to the bench executable if not on PATH for the service user
BENCH_BIN=bench

# Max seconds to let a single `bench new-site` provisioning run take
PROVISION_TIMEOUT_SECONDS=900
