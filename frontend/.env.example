# Copy to .env.local and fill in real values.

# Canonical public URL of this site — used for OpenGraph/Twitter metadata
# and canonical links (see app/layout.tsx). Set to the real scheme+host in
# every deploy; only omit for local dev, where it falls back to
# https://azeonsystems.com.ng.
NEXT_PUBLIC_SITE_URL=https://azeonsystems.com.ng

# Base URL of the Flask provisioner (see ../provisioner/README.md)
PROVISIONER_URL=http://127.0.0.1:8001

# Must match PROVISIONER_WEBHOOK_SECRET in provisioner/.env — this is the
# shared secret used to HMAC-sign requests the provisioner will accept.
PROVISIONER_WEBHOOK_SECRET=

# How /api/signup polls the provisioner job status before giving up
SIGNUP_POLL_INTERVAL_MS=3000
SIGNUP_POLL_TIMEOUT_MS=900000
